# --- Local runtime (rebuilt by the Phase 0 setup steps; see SETUP.md) ---
.venv/
.jdk/
.hadoop/
.spark-tmp/

# --- Source data ---
# flights.csv alone is 592 MB. Download from Kaggle into data/ instead;
# data/dot_to_iata.csv IS tracked, because it is our derived output.
data/flights.csv
data/airports.csv
data/airlines.csv

# --- Derived data and run outputs ---
data/parquet/
mlruns/
mlflow.db
stream_input/
stream_output/
checkpoints/

# --- Generated figures/tables (reproduced by benchmark_results.py) ---
# These WERE ignored, so a provisional table from a small validation run could
# never be mistaken for the real results. That risk is gone - the full 14-arm
# tournament is done - and both docs/benchmarks/ and models/ are named in the
# brief's required deliverable tree, so they are tracked now. ~840 KB total.
docs/benchmarks/*.log

# --- Editor ---
# Obsidian vault config, so REPORT.md can be read rendered. Anywhere in the
# tree: there is one at the repo root and one in docs/.
.obsidian/

# --- Python ---
__pycache__/
*.pyc
*.pyo
.ipynb_checkpoints/

# --- Logs ---
*.log
